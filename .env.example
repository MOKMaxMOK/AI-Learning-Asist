# ===== 本地儲存（SQLite）=====
# 資料庫檔案路徑（相對於專案根目錄；預設 data/app.db，會自動建立）
DATABASE_PATH=./data/app.db

# ===== 前端 API 位址 =====
# 後端即 Next.js 自己的 API Routes（同源），因此留空即可。
# 若要指向獨立後端伺服器，才需要填寫完整網址。
NEXT_PUBLIC_API_BASE_URL=

# ===== LLM =====
# 基於安全考量，這裡「不提供」任何 LLM 金鑰設定。
# 請在應用程式的「設置 → LLM 綁定」介面中輸入並儲存（存於本地 SQLite）。
